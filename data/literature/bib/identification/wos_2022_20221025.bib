Affiliation = {Ma, Junyi, Beijing Inst Technol, Vehicle Engn, Beijing 100081, Peoples R China.
   Ma, Junyi; Zhang, Jun; Xu, Jintao; Ai, Rui; Gu, Weihao, HAOMO AI Technol Co Ltd, Beijing 100081, Peoples R China.},
