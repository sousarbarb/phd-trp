  author = {Q. Wu and J. Wang and J. Liang and X. Gong and D. Manocha},
  journal = {IEEE Robotics and Automation Letters},
  title = {Image-Goal Navigation in Complex Environments via Modular Learning},
  volume = {7},
  number = {3},
